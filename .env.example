# ─── Database ─────────────────────────────────────────────────────────
# Postgres on Neon (serverless). Get from https://console.neon.tech
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ─── Site ─────────────────────────────────────────────────────────────
# Real https origin in production (used by sitemap, robots, and email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Floating WhatsApp button — raw international number, digits only (e.g.
# 6281234567890). Leave blank to hide the button entirely.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ─── Email ────────────────────────────────────────────────────────────
# Choose ONE transport (Gmail wins if both are set):
#
# A) FREE — Gmail SMTP via Nodemailer.
#    1. Turn on 2-Step Verification: https://myaccount.google.com/security
#    2. Create an app password: https://myaccount.google.com/apppasswords
#       (pick "Mail" + "Other" → name it "conscioustravel")
#    3. Paste the 16-char password (no spaces) below.
#    Sends from your Gmail address. Recipients see your Gmail.
#    Limit: ~500 emails/day for free Gmail accounts.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# B) PRODUCTION — Resend with a verified domain.
#    Requires owning a domain (e.g. conscioustravel.id) and adding DNS records.
RESEND_API_KEY=
#
# Optional overrides (work for both transports):
# EMAIL_FROM="Conscious Travel <hello@conscioustravel.id>"
# EMAIL_REPLY_TO="hello@conscioustravel.id"

# ─── Payments (Midtrans) — added in Phase: payments ───────────────────
# Use SB- sandbox keys while MIDTRANS_IS_PRODUCTION=false; swap to the
# production keys from the Midtrans dashboard before flipping to true.
MIDTRANS_SERVER_KEY=
# Exposed to the browser for Snap.js — must keep the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ─── Payments (Stripe) — added in Phase: payments ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Auth (NextAuth) — added in Phase: B2B portal ─────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Admin (MVP shared password) ──────────────────────────────────────
# Pick anything. Used to gate /admin pages. Replace with NextAuth later.
ADMIN_PASSWORD=
# Signs the admin session cookie (HMAC key). MUST be a long random secret in
# production — without it a public default salt is used and cookies are forgeable.
# Generate: openssl rand -hex 32
ADMIN_SECRET=
