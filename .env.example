# ─── Database ─────────────────────────────────────────────────────────
# Postgres on Neon (serverless). Get from https://console.neon.tech
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ─── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email ────────────────────────────────────────────────────────────
# Choose ONE transport (Gmail wins if both are set):
#
# A) FREE — Gmail SMTP via Nodemailer.
#    1. Turn on 2-Step Verification: https://myaccount.google.com/security
#    2. Create an app password: https://myaccount.google.com/apppasswords
#       (pick "Mail" + "Other" → name it "conscioustravel")
#    3. Paste the 16-char password (no spaces) below.
#    Sends from your Gmail address. Recipients see your Gmail.
#    Limit: ~500 emails/day for free Gmail accounts.
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# B) PRODUCTION — Resend with a verified domain.
#    Requires owning a domain (e.g. conscioustravel.id) and adding DNS records.
RESEND_API_KEY=
#
# Optional overrides (work for both transports):
# EMAIL_FROM="Conscious Travel <hello@conscioustravel.id>"
# EMAIL_REPLY_TO="hello@conscioustravel.id"

# ─── Payments (Midtrans) — added in Phase: payments ───────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ─── Payments (Stripe) — added in Phase: payments ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Auth (NextAuth) — added in Phase: B2B portal ─────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Admin (MVP shared password) ──────────────────────────────────────
# Pick anything. Used to gate /admin pages. Replace with NextAuth later.
ADMIN_PASSWORD=
