# ─── Database ─────────────────────────────────────────────────────────
# Postgres on Neon (serverless). Get from https://console.neon.tech
# Format: postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# ─── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Email (Resend) — added in Phase: email setup ─────────────────────
RESEND_API_KEY=

# ─── Payments (Midtrans) — added in Phase: payments ───────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# ─── Payments (Stripe) — added in Phase: payments ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Auth (NextAuth) — added in Phase: B2B portal ─────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
